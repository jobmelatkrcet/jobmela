EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=jobmela@tkrcetjobmela.in
EMAIL_HOST_PASSWORD=your_hostinger_email_password
