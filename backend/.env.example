# Django Core Settings
SECRET_KEY=django-insecure-replace-with-a-secure-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Database (PostgreSQL / Supabase Transaction Pooler)
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Storage Configuration
