# ========================================================
# TKRCET JOB MELA 2026 — BACKEND VERCEL ENVIRONMENT VARIABLES
# Copy these key-value pairs into your Vercel Project Settings:
# Settings -> Environment Variables
# ========================================================

# Supabase PostgreSQL Connection URL (Supavisor transaction pooler on port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Django Secret Key for Production Cryptographic Signing
SECRET_KEY=your-production-django-secret-key-here

# Production Debug Mode (Default: False for security)
DEBUG=False

# Allowed Hostnames (Comma-separated trusted hosts; wildcards are rejected in production)
ALLOWED_HOSTS=.vercel.app,jobmela-z1tj.vercel.app,jobmela.vercel.app,localhost,127.0.0.1

# Frontend Production Domain for CORS and Redirects
FRONTEND_URL=https://jobmela.vercel.app

# Cross-Origin Resource Sharing (CORS) Settings
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://jobmela.vercel.app

# Optional Seed Administrative Credentials (used only if running seed_data command)
ADMIN_SEED_EMAIL=admin@tkrcet.ac.in
ADMIN_SEED_PASSWORD=your-secure-admin-password-here

# Python Runtime Version for Vercel Serverless Function
PYTHON_VERSION=3.12

